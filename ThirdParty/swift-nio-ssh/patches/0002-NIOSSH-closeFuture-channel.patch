Subject: [PATCH 2/6] =?UTF-8?q?NIOSSH:=20closeFuture=20=E6=B0=B8=E4=B8=8D?=
 =?UTF-8?q?=E5=A4=B1=E8=B4=A5=EF=BC=9B=E5=B7=B2=E5=85=B3=E9=97=AD=20channe?=
 =?UTF-8?q?l=20=E4=B8=8A=E7=9A=84=E6=89=93=E5=BC=80=E8=AF=B7=E6=B1=82?=
 =?UTF-8?q?=E7=9B=B4=E6=8E=A5=E5=A4=B1=E8=B4=A5?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- 出错拆除（errorEncountered）时原代码让 closePromise 失败，违反 NIOCore「closeFuture 永不失败」
  的约定（Channel.closeFuture 的文档写明了）：NIOAsyncChannel.executeThenClose 对失败的
  closeFuture 断言，SSH 传输突然断开（parentChannelInactive → tcpShutdown）时，包成
  NIOAsyncChannel 的 direct-tcpip channel（`-L` 转发）在 Debug 构建里崩溃。改成 succeed；
  错误本身照旧经 fireErrorCaught、失败的待写数据、待关闭 promise 与激活 promise 报出去。
- 初始化器完成时 channel 已经关了，原代码用 closeFuture.cascadeFailure(to:) 让用户的 promise
  失败：closeFuture 一旦不再失败，这个 promise 就永远挂着。改成直接失败，错误取拆除 channel 的
  那个（新记的 closeError，比如 tcpShutdown），干净关闭时是 ChannelError.ioOnClosedChannel。
  上游的 testTCPCloseWhileAwaitingInitializer 照旧期待 tcpShutdown，不用改。

上游有两个用例断言了 closeFuture 会失败（testFailingOutboundChannelInitializerDoesNotDoIO、
testTCPCloseWhileAwaitingChannelSetup），按约定改成断言它成功；新增
testCloseFutureSucceedsWhenActiveChannelIsTornDownByTCPClose：已激活的 channel 被 TCP 断开时
errorCaught 收到 tcpShutdown、closeFuture 成功。

两处都是通用 bug（0.15.2 仍在），可以提给上游。
---
 .../Child Channels/SSHChildChannel.swift      | 15 ++++-
 .../ChildChannelMultiplexerTests.swift        | 59 ++++++++++++++++---
 2 files changed, 64 insertions(+), 10 deletions(-)

diff --git a/Sources/NIOSSH/Child Channels/SSHChildChannel.swift b/Sources/NIOSSH/Child Channels/SSHChildChannel.swift
index 2fed52a..d336626 100644
--- a/Sources/NIOSSH/Child Channels/SSHChildChannel.swift	
+++ b/Sources/NIOSSH/Child Channels/SSHChildChannel.swift	
@@ -105,6 +105,10 @@ final class SSHChildChannel {
 
     private var didClose = false
 
+    /// The error that tore this channel down, if any. Kept so that an initializer completing after the teardown
+    /// can fail its promise with the real reason: `closeFuture` never fails, so it cannot carry it.
+    private var closeError: Error?
+
     private var type: SSHChannelType?
 
     /// A promise from the user that will be fired when the channel goes active.
@@ -512,8 +516,9 @@ extension SSHChildChannel: Channel, ChannelCore {
             self.processOutboundMessage(.channelOpen(message), promise: nil)
             self.writePendingToMultiplexer()
         } else {
-            // Already closed, just fail this promise.
-            self.closeFuture.cascadeFailure(to: userPromise)
+            // Already closed, just fail this promise. Do not cascade from `closeFuture`: it never fails, so the
+            // promise would stay pending forever.
+            userPromise?.fail(self.closeError ?? ChannelError.ioOnClosedChannel)
         }
     }
 
@@ -592,6 +597,7 @@ extension SSHChildChannel: Channel, ChannelCore {
             return
         }
         self.didClose = true
+        self.closeError = error
 
         self.deliverPendingReads()
         self.failPendingWrites(error: error)
@@ -616,7 +622,10 @@ extension SSHChildChannel: Channel, ChannelCore {
 
         self.eventLoop.execute {
             self.removeHandlers(pipeline: self.pipeline)
-            self.closePromise.fail(error)
+            // `Channel.closeFuture` must never fail (NIOCore contract; `NIOAsyncChannel.executeThenClose` asserts
+            // on it). The error has already been reported through `fireErrorCaught`, the failed pending writes and
+            // the pending close / activation promises above.
+            self.closePromise.succeed(())
             self.multiplexer.childChannelErrored(
                 channelID: self.state.localChannelIdentifier,
                 expectClose: !self.state.isClosed
diff --git a/Tests/NIOSSHTests/ChildChannelMultiplexerTests.swift b/Tests/NIOSSHTests/ChildChannelMultiplexerTests.swift
index ef9b13f..5bbeab5 100644
--- a/Tests/NIOSSHTests/ChildChannelMultiplexerTests.swift
+++ b/Tests/NIOSSHTests/ChildChannelMultiplexerTests.swift
@@ -603,14 +603,15 @@ final class ChildChannelMultiplexerTests: XCTestCase {
             XCTFail("Did not create child channel")
             return
         }
-        let childCloseError = NIOLoopBoundBox<Error?>(nil, eventLoop: channel.eventLoop)
+        // closeFuture never fails: it only reports that the channel closed.
+        let childClosed = NIOLoopBoundBox(false, eventLoop: channel.eventLoop)
 
-        channel.closeFuture.whenFailure { error in childCloseError.value = error }
+        channel.closeFuture.whenSuccess { childClosed.value = true }
 
         // Channel doesn't go active yet.
         XCTAssertFalse(channel.isActive)
         XCTAssertTrue(channel.isWritable)
-        XCTAssertNil(childCloseError.value)
+        XCTAssertFalse(childClosed.value)
         XCTAssertEqual(harness.flushedMessages.count, 0)
 
         promise.fail(MultiplexerTestError.rejected)
@@ -619,7 +620,7 @@ final class ChildChannelMultiplexerTests: XCTestCase {
         harness.eventLoop.run()
         XCTAssertFalse(channel.isActive)
         XCTAssertTrue(channel.isWritable)
-        XCTAssertEqual(childCloseError.value as? MultiplexerTestError, .rejected)
+        XCTAssertTrue(childClosed.value)
         XCTAssertEqual(harness.flushedMessages.count, 0)
     }
 
@@ -1816,8 +1817,51 @@ final class ChildChannelMultiplexerTests: XCTestCase {
         XCTAssertEqual((childPromiseError.value as? NIOSSHError?)??.type, .tcpShutdown)
 
         harness.eventLoop.run()
-        XCTAssertThrowsError(try channel.closeFuture.wait()) { error in
-            XCTAssertEqual((error as? NIOSSHError)?.type, .tcpShutdown)
+        // closeFuture never fails (the NIOCore contract): the error went to the promise above.
+        XCTAssertNoThrow(try channel.closeFuture.wait())
+    }
+
+    func testCloseFutureSucceedsWhenActiveChannelIsTornDownByTCPClose() throws {
+        let errorLogger = ErrorLoggingHandler()
+        let harness = self.harnessForbiddingInboundChannels()
+        defer {
+            harness.finish()
+        }
+
+        var childChannel: Channel?
+        harness.multiplexer.createChildChannel(channelType: .session) { channel, _ in
+            childChannel = channel
+            return channel.eventLoop.makeCompletedFuture {
+                try channel.pipeline.syncOperations.addHandler(errorLogger)
+            }
+        }
+        guard let channel = childChannel else {
+            XCTFail("Did not create child channel")
+            return
+        }
+        let channelID = self.assertChannelOpen(harness.flushedMessages.first)
+        XCTAssertNoThrow(
+            try harness.multiplexer.receiveMessage(self.openConfirmation(originalChannelID: channelID!, peerChannelID: 1))
+        )
+        XCTAssertTrue(channel.isActive)
+
+        let closeResult = NIOLoopBoundBox<Result<Void, Error>?>(nil, eventLoop: harness.eventLoop)
+        channel.closeFuture.whenComplete { closeResult.value = $0 }
+
+        // The SSH transport goes away underneath an open channel (network drop, peer reset).
+        harness.multiplexer.parentChannelInactive()
+        harness.eventLoop.run()
+
+        XCTAssertFalse(channel.isActive)
+        XCTAssertEqual(errorLogger.errors.count, 1)
+        XCTAssertEqual((errorLogger.errors.first as? NIOSSHError)?.type, .tcpShutdown)
+        switch closeResult.value {
+        case .some(.success):
+            ()
+        case .some(.failure(let error)):
+            XCTFail("closeFuture must never fail, failed with \(error)")
+        case .none:
+            XCTFail("closeFuture did not complete")
         }
     }
 
@@ -1845,7 +1889,8 @@ final class ChildChannelMultiplexerTests: XCTestCase {
         harness.eventLoop.run()
         XCTAssertNil(childPromiseError.value)
 
-        // Now complete the delay promise.
+        // Now complete the delay promise. The channel is already closed, so the promise fails at once with the
+        // error that closed it (it used to be cascaded from closeFuture, which never fails, and would then hang).
         delayPromise.succeed(())
         XCTAssertEqual((childPromiseError.value as? NIOSSHError?)??.type, .tcpShutdown)
     }
