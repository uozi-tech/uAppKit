diff --git a/Tests/NIOSSHTests/RekeyTests.swift b/Tests/NIOSSHTests/RekeyTests.swift
new file mode 100644
index 0000000..fb17550
--- /dev/null
+++ b/Tests/NIOSSHTests/RekeyTests.swift
@@ -0,0 +1,162 @@
+//===----------------------------------------------------------------------===//
+//
+// This file is part of uAppKit's patches to the SwiftNIO SSH project.
