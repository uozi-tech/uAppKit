+import NIOCore
+import NIOEmbedded
+import XCTest
+
+@testable import NIOSSH
+
+/// Half-closure end to end: the peer sends EOF first, we keep writing and then send ours.
+final class ChannelHalfClosureTests: XCTestCase {
+    func testWritesAndEOFAfterThePeersEOF() throws {
+        let channel = BackToBackEmbeddedChannel()
+        defer { XCTAssertNoThrow(try channel.finish()) }
+
+        let serverReads = ReadRecordingHandler()
+        let serverEOF = EOFRecorder()
+        let serverErrors = ErrorLoggingHandler()
+        var serverChild: Channel?
+
+        let clientHandler = NIOSSHHandler(
+            role: .client(
+                .init(userAuthDelegate: InfinitePasswordDelegate(), serverAuthDelegate: AcceptAllHostKeysDelegate())
+            ),
+            allocator: channel.client.allocator,
+            inboundChildChannelInitializer: nil
+        )
+        let serverHandler = NIOSSHHandler(
+            role: .server(
+                .init(hostKeys: [.init(ed25519Key: .init())], userAuthDelegate: DenyThenAcceptDelegate(messagesToDeny: 0))
+            ),
+            allocator: channel.server.allocator
+        ) { child, _ in
+            serverChild = child
+            return child.eventLoop.makeCompletedFuture {
+                try child.syncOptions!.setOption(.allowRemoteHalfClosure, value: true)
+                try child.pipeline.syncOperations.addHandlers([serverReads, serverEOF, serverErrors])
+            }
+        }
+        XCTAssertNoThrow(try channel.client.pipeline.syncOperations.addHandler(clientHandler))
+        XCTAssertNoThrow(try channel.server.pipeline.syncOperations.addHandler(serverHandler))
+        XCTAssertNoThrow(try channel.activate())
+        XCTAssertNoThrow(try channel.interactInMemory())
+
+        let clientEOF = EOFRecorder()
+        let clientErrors = ErrorLoggingHandler()
+        let clientChildPromise = channel.client.eventLoop.makePromise(of: Channel.self)
+        clientHandler.createChannel(clientChildPromise) { child, _ in
+            child.eventLoop.makeCompletedFuture {
+                try child.syncOptions!.setOption(.allowRemoteHalfClosure, value: true)
+                try child.pipeline.syncOperations.addHandlers([clientEOF, clientErrors])
+            }
+        }
+        XCTAssertNoThrow(try channel.interactInMemory())
+        let clientChild = try clientChildPromise.futureResult.wait()
+        guard let serverChild = serverChild else {
+            XCTFail("No server channel")
+            return
+        }
+
+        // The server is done talking first.
+        XCTAssertNoThrow(try serverChild.close(mode: .output).wait())
+        XCTAssertNoThrow(try channel.interactInMemory())
+        XCTAssertTrue(clientEOF.seenEOF)
+        XCTAssertTrue(clientChild.isActive)
+
+        // The client still has things to say, then says EOF.
+        var payload = clientChild.allocator.buffer(capacity: 16)
+        payload.writeString("still talking")
+        let write = clientChild.writeAndFlush(SSHChannelData(type: .channel, data: .byteBuffer(payload)))
+        let eof = clientChild.close(mode: .output)
+        XCTAssertNoThrow(try channel.interactInMemory())
+        XCTAssertNoThrow(try write.wait())
+        XCTAssertNoThrow(try eof.wait())
+        XCTAssertEqual(serverReads.reads, [SSHChannelData(type: .channel, data: .byteBuffer(payload))])
+        XCTAssertTrue(serverEOF.seenEOF)
+        XCTAssertTrue(clientChild.isActive)
+
+        // Both sides are quiescent: a clean close, no errors anywhere.
+        let close = clientChild.close()
+        XCTAssertNoThrow(try channel.interactInMemory())
+        XCTAssertNoThrow(try close.wait())
+        XCTAssertNoThrow(try clientChild.closeFuture.wait())
+        XCTAssertNoThrow(try serverChild.closeFuture.wait())
+        XCTAssertEqual(clientErrors.errors.count, 0)
+        XCTAssertEqual(serverErrors.errors.count, 0)
+    }
+}
diff --git a/Tests/NIOSSHTests/ChildChannelStateMachineTests.swift b/Tests/NIOSSHTests/ChildChannelStateMachineTests.swift
index 0e74547..560cd57 100644
--- a/Tests/NIOSSHTests/ChildChannelStateMachineTests.swift
+++ b/Tests/NIOSSHTests/ChildChannelStateMachineTests.swift
@@ -83,4 +83,47 @@ final class ChildChannelStateMachineTests: XCTestCase {
         XCTAssertFalse(afterEOF.sentClose)
         XCTAssertFalse(afterEOF.canSendWindowAdjust)
     }
+
+    // MARK: EOF in both directions
+
+    func testEOFOrderings() throws {
+        // We send EOF first, then the peer.
+        var localFirst = try self.activeOutboundChannel()
+        try localFirst.sendChannelEOF(.init(recipientChannel: 2))
+        XCTAssertTrue(localFirst.isActiveOnChannel)
+        try localFirst.receiveChannelEOF(.init(recipientChannel: 1))
+        XCTAssertNoThrow(try localFirst.sendChannelClose(.init(recipientChannel: 2)))
+
+        // The peer sends EOF first, then we do: the end of a `-L` stream whose server half-closes first, or EOF on an
+        // exec whose output already ended. Used to throw "Sent EOF out of sequence.".
+        var remoteFirst = try self.activeOutboundChannel()
+        try remoteFirst.receiveChannelEOF(.init(recipientChannel: 1))
+        XCTAssertNoThrow(try remoteFirst.sendChannelData(.init(recipientChannel: 2, data: ByteBuffer())))
+        XCTAssertNoThrow(try remoteFirst.sendChannelEOF(.init(recipientChannel: 2)))
+        XCTAssertThrowsError(try remoteFirst.sendChannelData(.init(recipientChannel: 2, data: ByteBuffer())))
+        XCTAssertThrowsError(try remoteFirst.receiveChannelEOF(.init(recipientChannel: 1)))
+        XCTAssertNoThrow(try remoteFirst.sendChannelClose(.init(recipientChannel: 2)))
+        XCTAssertNoThrow(try remoteFirst.receiveChannelClose(.init(recipientChannel: 1)))
+        XCTAssertTrue(remoteFirst.isClosed)
+
+        // We may send EOF only once...
+        var localTwice = try self.activeOutboundChannel()
+        try localTwice.sendChannelEOF(.init(recipientChannel: 2))
+        XCTAssertThrowsError(try localTwice.sendChannelEOF(.init(recipientChannel: 2))) { error in
+            XCTAssertEqual((error as? NIOSSHError)?.type, .protocolViolation)
+        }
+
+        // ... and so may the peer.
+        var remoteTwice = try self.activeOutboundChannel()
+        try remoteTwice.receiveChannelEOF(.init(recipientChannel: 1))
+        XCTAssertThrowsError(try remoteTwice.receiveChannelEOF(.init(recipientChannel: 1))) { error in
+            XCTAssertEqual((error as? NIOSSHError)?.type, .protocolViolation)
+        }
+
+        // Both EOFs sent and received: a third one either way is out of sequence.
+        var quiescent = try self.activeOutboundChannel()
+        try quiescent.receiveChannelEOF(.init(recipientChannel: 1))
+        try quiescent.sendChannelEOF(.init(recipientChannel: 2))
+        XCTAssertThrowsError(try quiescent.sendChannelEOF(.init(recipientChannel: 2)))
+    }
 }
