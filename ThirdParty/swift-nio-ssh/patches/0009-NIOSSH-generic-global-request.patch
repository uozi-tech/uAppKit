diff --git a/Tests/NIOSSHTests/GenericGlobalRequestTests.swift b/Tests/NIOSSHTests/GenericGlobalRequestTests.swift
new file mode 100644
index 0000000..a6207e6
--- /dev/null
+++ b/Tests/NIOSSHTests/GenericGlobalRequestTests.swift
@@ -0,0 +1,140 @@
+//===----------------------------------------------------------------------===//
+//
+// This file is part of uAppKit's patches to the SwiftNIO SSH project.
+//
+// Copyright (c) 2026 the uAppKit authors
+// Licensed under Apache License v2.0
