@@ -0,0 +1,272 @@
+//===----------------------------------------------------------------------===//
+//
+// This file is part of uAppKit's patches to the SwiftNIO SSH project.
+//
+// Copyright (c) 2026 the uAppKit authors
+// Licensed under Apache License v2.0
