diff --git a/Sources/NIOSSH/Connection State Machine/Operations/AcceptsUserAuthMessages.swift b/Sources/NIOSSH/Connection State Machine/Operations/AcceptsUserAuthMessages.swift
index 4cb943c..33fc190 100644
--- a/Sources/NIOSSH/Connection State Machine/Operations/AcceptsUserAuthMessages.swift	
+++ b/Sources/NIOSSH/Connection State Machine/Operations/AcceptsUserAuthMessages.swift	
@@ -59,8 +59,8 @@ extension AcceptsUserAuthMessages {
 
         if let future = result {
             return .possibleFutureMessage(
-                future.map {
-                    Self.transform($0)
+                future.flatMapThrowing {
+                    try Self.transform($0)
                 }
             )
         } else {
@@ -102,8 +102,8 @@ extension AcceptsUserAuthMessages {
 
         if let future = result {
             return .possibleFutureMessage(
-                future.map {
-                    Self.transform($0)
+                future.flatMapThrowing {
+                    try Self.transform($0)
                 }
             )
         } else {
@@ -143,7 +143,12 @@ extension AcceptsUserAuthMessages {
         }
     }
 
-    private static func transform(_ result: SSHMessage.UserAuthRequestMessage?) -> SSHMultiMessage? {
-        result.map { SSHMultiMessage(.userAuthRequest($0)) }
+    private static func transform(_ result: SSHMessage.UserAuthRequestMessage?) throws -> SSHMultiMessage? {
+        // The client's delegate has nothing more to offer: authentication has failed. Say so instead of leaving
+        // the connection waiting forever.
+        guard let result = result else {
+            throw NIOSSHError.noFurtherAuthenticationOffers
+        }
+        return SSHMultiMessage(.userAuthRequest(result))
     }
 }
diff --git a/Sources/NIOSSH/NIOSSHError.swift b/Sources/NIOSSH/NIOSSHError.swift
