{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@ 命令行接口并发已满（上限 %lld 条连接），稍后重试" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ command-line interface is at capacity (limit: %2$lld connections). Try again later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のコマンドラインインターフェイスは同時接続数の上限（%2$lld）に達しています。しばらくしてから再試行してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 명령줄 인터페이스의 동시 연결이 가득 찼습니다(한도 %2$lld개). 잠시 후 다시 시도하세요"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 命令列介面的並行連線已滿（上限 %2$lld 條），請稍後重試"
          }
        }
      }
    },
    "%@ 正从临时位置运行（磁盘映像，或下载后没拖进「应用程序」），先把 %@.app 移到「应用程序」文件夹再安装。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is running from a temporary location (a disk image, or it wasn't moved to Applications after downloading). Move %2$@.app to the Applications folder, then install."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ が一時的な場所から実行されています（ディスクイメージ、またはダウンロード後に「アプリケーション」へ移動していない）。%2$@.app を「アプリケーション」フォルダへ移動してからインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 임시 위치에서 실행 중입니다(디스크 이미지이거나 다운로드 후 '응용 프로그램'으로 옮기지 않음). %2$@.app을 '응용 프로그램' 폴더로 옮긴 후 설치하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正從暫時位置執行（磁碟映像檔，或下載後沒拖進「應用程式」），請先把 %2$@.app 移到「應用程式」檔案夾再安裝。"
          }
        }
      }
    },
    "%@ 的长时请求并发已满（上限 %lld 个），稍后重试" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has too many long-running requests (limit: %2$lld). Try again later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の長時間リクエストが上限（%2$lld 件）に達しています。しばらくしてから再試行してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 장시간 요청이 가득 찼습니다(한도 %2$lld개). 잠시 후 다시 시도하세요"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的長時請求並行數已滿（上限 %2$lld 個），請稍後重試"
          }
        }
      }
    },
